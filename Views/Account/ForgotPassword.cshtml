@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<link href="~/css/auth.css" rel="stylesheet" />

<div class="auth-wrap">
    <div class="forgot-icon">
        <i class="fa-solid fa-lock"></i>
    </div>
    <h1>Forgot Password?</h1>
    <p class="sub">
        Don't worry! Enter your registered email address
        and we'll send you a verification code to reset
        your password.
    </p>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    <div asp-validation-summary="All"
         class="alert alert-danger"
         style="display:@(ViewData.ModelState.IsValid ? "none" : "block")">
    </div>
    <form asp-controller="Account"
          asp-action="ForgotPassword"
          method="post">
        @Html.AntiForgeryToken()
        <label for="Email">
            Email Address
        </label>
        <div class="input-box">
            <i class="fa-solid fa-envelope"></i>
            <input type="email"
                   id="Email"
                   name="Email"
                   placeholder="you@example.com"
                   autocomplete="email"
                   required />
        </div>
        <button type="submit">
            <i class="fa-solid fa-paper-plane"></i>
            &nbsp; Send Reset Code
        </button>
    </form>
    <div class="back-login">
        <a asp-controller="Account"
           asp-action="Login">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Login
        </a>
    </div>
    <div class="security-box">
        <i class="fa-solid fa-shield-halved"></i>
        <p>
            For your security, the verification code will
            only be sent to the email address registered
            with your account.
        </p>
    </div>
</div>
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />