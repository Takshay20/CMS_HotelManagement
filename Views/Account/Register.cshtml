@model CMS_HotelBooking.ViewModels.RegisterVM

@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

<style>
    .auth-wrap {
        width: 90%;
        max-width: 500px;
        margin: 30px auto 60px;
        background: #fff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .auth-wrap h1 {
        text-align: center;
        margin-bottom: 10px;
        color: #222;
    }

    .auth-wrap p.sub {
        text-align: center;
        color: #888;
        margin-bottom: 30px;
        line-height: 1.5;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .auth-wrap label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
    }

    .auth-wrap input,
    .country-code {
        width: 100%;
        box-sizing: border-box;
        padding: 13px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 16px;
        outline: none;
        transition: .3s;
    }

    .auth-wrap input:focus,
    .country-code:focus {
        border-color: #D4AF37;
        box-shadow: 0 0 8px rgba(212,175,55,.25);
    }

    .input-error {
        border-color: #dc3545 !important;
        box-shadow: 0 0 8px rgba(220,53,69,.15) !important;
    }

    .input-valid {
        border-color: #198754 !important;
        box-shadow: 0 0 8px rgba(25,135,84,.15) !important;
    }

    .field-error {
        display: none;
        margin-top: 7px;
        color: #dc3545;
        font-size: 14px;
    }

    .field-error.show {
        display: block;
    }

    .validation-summary {
        display: none;
        background: #fff0f1;
        border: 1px solid #dc3545;
        color: #dc3545;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 25px;
    }

    .validation-summary.show {
        display: block;
    }

    .validation-summary ul {
        margin: 0;
        padding-left: 20px;
    }

    .phone-row {
        display: flex;
        gap: 10px;
    }

    .country-wrapper {
        width: 125px;
        flex-shrink: 0;
    }

    .phone-wrapper {
        flex: 1;
    }

    .auth-wrap button {
        width: 100%;
        padding: 14px;
        background: #D4AF37;
        color: #fff;
        border: none;
        border-radius: 30px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: .3s;
    }

    .auth-wrap button:hover {
        background: #0F172A;
    }

    .auth-wrap button:disabled {
        opacity: .7;
        cursor: not-allowed;
    }

    .auth-wrap .switch {
        text-align: center;
        margin-top: 20px;
        color: #666;
    }

    .auth-wrap .switch a {
        color: #D4AF37;
        font-weight: 600;
        text-decoration: none;
    }

    .auth-wrap .switch a:hover {
        text-decoration: underline;
    }

    @@media (max-width: 500px) {

        .auth-wrap {
            width: 88%;
            padding: 25px;
        }

        .phone-row {
            flex-direction: column;
        }

        .country-wrapper {
            width: 100%;
        }
    }
</style>

<div class="auth-wrap">

    <h1>Create Account</h1>

    <p class="sub">
        Register to book rooms and manage your stay at
        Royal Paradise Hotel
    </p>

    <div id="validationSummary" class="validation-summary">
        <ul id="validationList"></ul>
    </div>

    <div asp-validation-summary="ModelOnly"
         class="validation-summary"
         style="display:@(ViewData.ModelState.IsValid ? "none" : "block")">
    </div>

    <form id="registerForm"
          asp-controller="Account"
          asp-action="Register"
          method="post"
          novalidate>

        @Html.AntiForgeryToken()

        <div class="form-group">

            <label for="FullName">
                Full Name
            </label>

            <input asp-for="FullName"
                   id="FullName"
                   type="text"
                   placeholder="Your Full Name"
                   maxlength="150"
                   autocomplete="name">

            <div id="fullNameError"
                 class="field-error">
            </div>

            <span asp-validation-for="FullName"
                  class="field-error">
            </span>

        </div>

        <div class="form-group">

            <label for="Email">
                Email Address
            </label>

            <input asp-for="Email"
                   id="Email"
                   type="text"
                   placeholder="you@example.com"
                   maxlength="150"
                   autocomplete="email">

            <div id="emailError"
                 class="field-error">
            </div>

        </div>

        <div class="form-group">

            <label>
                Phone Number
            </label>

            <div class="phone-row">

                <div class="country-wrapper">

                    <select id="CountryCode"
                            class="country-code">

                        <option value="+91">IN +91</option>
                        <option value="+1">US +1</option>
                        <option value="+44">UK +44</option>
                        <option value="+61">AU +61</option>
                        <option value="+971">UAE +971</option>
                        <option value="+65">SG +65</option>
                        <option value="+81">JP +81</option>
                        <option value="+49">DE +49</option>
                        <option value="+33">FR +33</option>

                    </select>

                </div>

                <div class="phone-wrapper">

                    <input asp-for="Phone"
                           id="Phone"
                           type="text"
                           placeholder="Enter phone number"
                           maxlength="10"
                           autocomplete="tel">

                </div>

            </div>

            <div id="phoneError"
                 class="field-error">
            </div>

        </div>

        <div class="form-group">

            <label for="Password">
                Password
            </label>

            <input asp-for="Password"
                   id="Password"
                   type="password"
                   placeholder="••••••••"
                   maxlength="100"
                   autocomplete="new-password">

            <div id="passwordError"
                 class="field-error">
            </div>

        </div>

        <div class="form-group">

            <label for="ConfirmPassword">
                Confirm Password
            </label>

            <input asp-for="ConfirmPassword"
                   id="ConfirmPassword"
                   type="password"
                   placeholder="••••••••"
                   maxlength="100"
                   autocomplete="new-password">

            <div id="confirmPasswordError"
                 class="field-error">
            </div>

        </div>

        <button type="submit"
                id="registerButton">
            Create Account
        </button>

    </form>

    <p class="switch">
        Already have an account?
        <a asp-controller="Account"
           asp-action="Login">
            Login here
        </a>
    </p>

</div>

@section Scripts {

    <script src="~/js/Account.js"> </script>

}