@{
    ViewData["Title"] = "Verify Code";
    Layout = "_AuthLayout";
}

<style>
    .auth-wrap {
        width: 90%;
        max-width: 450px;
        margin: 30px auto 60px;
        background: #fff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .forgot-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba(212,175,55,.12);
        border: 2px solid #D4AF37;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #D4AF37;
        font-size: 28px;
    }

    .auth-wrap h1 {
        text-align: center;
        margin-bottom: 10px;
        color: #222;
        font-family: Georgia, serif;
    }

    .auth-wrap p.sub {
        text-align: center;
        color: #888;
        margin-bottom: 30px;
        line-height: 1.6;
        font-size: 14px;
    }

    .auth-wrap p.sub strong {
        color: #333;
    }

    .auth-wrap label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
    }

    .input-box {
        position: relative;
        margin-bottom: 20px;
    }

        .input-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #D4AF37;
            font-size: 15px;
        }

    .auth-wrap input[type="text"],
    .auth-wrap input[type="password"] {
        width: 100%;
        padding: 13px 13px 13px 44px;
        border: 1px solid #ddd;
        border-radius: 8px;
        outline: none;
        transition: .3s;
        font-size: 14px;
    }

    .auth-wrap input#Code {
        letter-spacing: 8px;
        font-weight: 700;
        text-align: center;
        padding-left: 13px;
    }

        .auth-wrap input:focus {
            border-color: #D4AF37;
            box-shadow: 0 0 0 3px rgba(212,175,55,.12);
        }

    .auth-wrap button {
        width: 100%;
        padding: 14px;
        background: #D4AF37;
        color: #fff;
        border: none;
        border-radius: 30px;
        font-size: 16px;
        cursor: pointer;
        transition: .3s;
        margin-top: 5px;
    }

        .auth-wrap button:hover {
            background: #0F172A;
        }

    .back-login {
        text-align: center;
        margin-top: 22px;
    }

        .back-login a {
            color: #D4AF37;
            font-weight: 600;
            text-decoration: none;
        }

            .back-login a:hover {
                color: #0F172A;
            }

    .alert {
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .alert-success {
        background: #edf8f0;
        border: 1px solid #b8ddc2;
        color: #287a45;
    }

    .alert-danger {
        background: #fff1f0;
        border: 1px solid #e5b8b3;
        color: #c0392b;
    }

    @@media (max-width: 500px) {
        .auth-wrap {
            padding: 30px 24px;
        }

        .auth-wrap h1 {
            font-size: 28px;
        }
    }
</style>

<div class="auth-wrap">

    <div class="forgot-icon">
        <i class="fa-solid fa-key"></i>
    </div>

    <h1>Verify &amp; Reset</h1>

    <p class="sub">
        Enter the 6-digit code sent to <strong>@ViewBag.Email</strong>
        and choose a new password.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div asp-validation-summary="All"
         class="alert alert-danger"
         style="display:@(ViewData.ModelState.IsValid ? "none" : "block")">
    </div>

    <form asp-controller="Account" asp-action="VerifyResetCode" method="post">

        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@ViewBag.Email" />

        <label for="Code">Verification Code</label>
        <div class="input-box">
            <input type="text"
                   id="Code"
                   name="code"
                   maxlength="6"
                   inputmode="numeric"
                   pattern="[0-9]{6}"
                   placeholder="000000"
                   autocomplete="one-time-code"
                   required />
        </div>

        <label for="NewPassword">New Password</label>
        <div class="input-box">
            <i class="fa-solid fa-lock"></i>
            <input type="password"
                   id="NewPassword"
                   name="newPassword"
                   placeholder="Enter new password"
                   minlength="6"
                   maxlength="100"
                   required />
        </div>

        <label for="ConfirmPassword">Confirm Password</label>
        <div class="input-box">
            <i class="fa-solid fa-lock"></i>
            <input type="password"
                   id="ConfirmPassword"
                   name="confirmPassword"
                   placeholder="Re-enter new password"
                   minlength="6"
                   maxlength="100"
                   required />
        </div>

        <button type="submit">
            <i class="fa-solid fa-check"></i>
            &nbsp; Reset Password
        </button>
    </form>

    <div class="back-login">
        <a asp-controller="Account" asp-action="ForgotPassword">
            <i class="fa-solid fa-arrow-left"></i>
            Didn't get a code? Try again
        </a>
    </div>

</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
