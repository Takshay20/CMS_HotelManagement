@model CMS_HotelBooking.ViewModels.ContactVM

@{
    ViewData["Title"] = "Contact & Booking";
   
}

<style>
    body {
        background-image: url("../images/DeluxeRoom/DeluxeRoom4.jfif");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
    }

    .contact {
        width: 90%;
        max-width: 1400px;
        margin: 80px auto;
    }

    .title {
        text-align: center;
        margin-bottom: 50px;
    }

    .title h1 {
        font-size: 42px;
        color: #0F172A;
        margin-bottom: 15px;
    }

    .title p {
        width: 70%;
        margin: 0 auto;
        color: burlywood;
        border:dotted;
        border-block-color:beige;
        background-color:antiquewhite;
        
        line-height: 28px;
        font-size: 16px;
    }

    .contact-box {
        display: flex;
        gap: 35px;
        align-items: stretch;
    }

    .contact-form {
        flex: 2;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,.15);
        padding: 35px;
        transition: .4s ease;
    }

    .contact-form:hover {
        transform: translateY(-5px);
    }

    .contact-form h2 {
        margin: 0 0 30px;
        color: #0F172A;
        font-size: 32px;
    }

    .row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group {
        flex: 1;
        min-width: 0;
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
        font-size: 15px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 14px;
        border: 1px solid #ddd;
        border-radius: 6px;
        outline: none;
        font-size: 15px;
        font-family: inherit;
        transition: .3s ease;
        background: #fff;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        border-color: #D4AF37;
        box-shadow: 0 0 8px rgba(212,175,55,.35);
    }

    .form-group textarea {
        height: 140px;
        resize: vertical;
        min-height: 120px;
        max-height: 300px;
    }

    .phone-input-row {
        display: flex;
        gap: 10px;
        width: 100%;
    }

    .phone-input-row select {
        width: 155px;
        flex-shrink: 0;
    }

    .phone-input-row input {
        flex: 1;
        min-width: 0;
    }

    .optional {
        color: #999;
        font-weight: 400;
    }

    .field-error {
        min-height: 22px;
        margin-top: 7px;
        color: #dc3545;
        font-size: 14px;
        line-height: 1.5;
    }

    .input-error {
        border-color: #dc3545 !important;
        box-shadow: 0 0 6px rgba(220,53,69,.20) !important;
    }

    .input-valid {
        border-color: #198754 !important;
        box-shadow: 0 0 6px rgba(25,135,84,.20) !important;
    }

    .contact-submit {
        background: #D4AF37;
        color: #fff;
        border: none;
        padding: 15px 40px;
        border-radius: 30px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
        transition: .4s ease;
        margin-top: 5px;
    }

    .contact-submit:hover {
        background: #0F172A;
        transform: scale(1.05);
    }

    .contact-submit:disabled {
        opacity: .7;
        cursor: not-allowed;
        transform: none;
    }

    #contactAlert {
        margin-bottom: 20px;
    }

    .contact-alert {
        padding: 13px 16px;
        border-radius: 6px;
        margin-bottom: 15px;
        font-size: 15px;
    }

    .contact-alert.success {
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
    }

    .contact-alert.error {
        background: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }

    .form-note {
        margin-top: 15px;
        color: #666;
        font-size: 14px;
        line-height: 22px;
    }

    .form-note a {
        color: #D4AF37;
        text-decoration: none;
        font-weight: 600;
    }

    .form-note a:hover {
        text-decoration: underline;
    }

    .contact-info {
        flex: 1;
        color: #fff;
        padding: 35px;
        border-radius: 12px;
        background: #0F172A;
        box-shadow: 0 5px 20px rgba(0,0,0,.25);
    }

    .contact-info h2 {
        margin: 0 0 20px;
        font-size: 30px;
    }

    .contact-info hr {
        margin: 20px 0;
        border: none;
        border-top: 1px solid #D4AF37;
    }

    .contact-info p {
        margin: 20px 0;
        line-height: 28px;
    }

    .contact-info iframe {
        width: 100%;
        height: 250px;
        border: none;
        border-radius: 10px;
        margin-top: 20px;
    }

    @@media (max-width: 900px) {
        .contact {
            width: 94%;
        }

        .contact-box {
            flex-direction: column;
        }

        .title p {
            width: 90%;
        }

        .contact-form,
        .contact-info {
            width: 100%;
            box-sizing: border-box;
        }
    }

    @@media (max-width: 650px) {
        .contact {
            margin: 50px auto;
        }

        .title h1 {
            font-size: 32px;
        }

        .title p {
            width: 100%;
            font-size: 15px;
        }

        .contact-form,
        .contact-info {
            padding: 25px;
        }

        .contact-form h2 {
            font-size: 28px;
        }

        .row {
            flex-direction: column;
            gap: 0;
            margin-bottom: 0;
        }

        .phone-input-row {
            gap: 8px;
        }

        .phone-input-row select {
            width: 125px;
        }
    }
</style>

<section class="contact">

    <div class="title">
        <h1>Contact &amp; Booking</h1>

        <p>
            We'd love to hear from you. Reserve your stay at
            <b>Royal Paradise Hotel</b> and enjoy a luxurious experience.
        </p>
    </div>

    <div class="contact-box">

        <div class="contact-form">

            <h2>Get In Touch</h2>

            <div id="contactAlert"></div>

            <form id="contactForm" novalidate>

                <div class="row">

                    <div class="form-group">

                        <label for="name">
                            Full Name
                        </label>

                        <input type="text"
                               id="name"
                               name="Name"
                               placeholder="Enter Full Name"
                               maxlength="150"
                               autocomplete="name">

                        <div class="field-error" id="nameError"></div>

                    </div>

                    <div class="form-group">

                        <label for="phoneNumber">
                            Phone Number
                        </label>

                        <div class="phone-input-row">

                            <select id="countryCode"
                                    name="CountryCode">

                                <option value="+91" data-length="10">
                                    IN +91
                                </option>

                                <option value="+1" data-length="10">
                                    US +1
                                </option>

                                <option value="+44" data-length="10">
                                    UK +44
                                </option>

                                <option value="+61" data-length="9">
                                    AU +61
                                </option>

                                <option value="+971" data-length="9">
                                    AE +971
                                </option>

                            </select>

                            <input type="text"
                                   id="phoneNumber"
                                   placeholder="Enter phone number"
                                   maxlength="10"
                                   inputmode="numeric"
                                   autocomplete="tel">

                        </div>

                        <input type="hidden"
                               id="fullPhone"
                               name="Phone">

                        <div class="field-error" id="phoneError"></div>

                    </div>

                </div>

                <div class="row">

                    <div class="form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <input type="text"
                               id="email"
                               name="Email"
                               placeholder="Enter Email Address"
                               maxlength="150"
                               autocomplete="email">

                        <div class="field-error" id="emailError"></div>

                    </div>

                    <div class="form-group">

                        <label for="subject">
                            Subject
                        </label>

                        <select id="subject"
                                name="Subject">

                            <option value="">
                                Select Subject
                            </option>

                            <option value="Booking Enquiry">
                                Booking Enquiry
                            </option>

                            <option value="Payment Related">
                                Payment Related
                            </option>

                            <option value="Cancellation & Refund">
                                Cancellation &amp; Refund
                            </option>

                            <option value="Room Related">
                                Room Related
                            </option>

                            <option value="Feedback">
                                Feedback
                            </option>

                            <option value="Complaint">
                                Complaint
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                        <div class="field-error" id="subjectError"></div>

                    </div>

                </div>

                <div class="form-group">

                    <label for="message">
                        Message
                        <span class="optional">(Optional)</span>
                    </label>

                    <textarea id="message"
                              name="Message"
                              maxlength="1000"
                              placeholder="Write your message here... (optional)"></textarea>

                </div>

                <button type="submit"
                        class="contact-submit">
                    Send Message
                </button>

            </form>

            <p class="form-note">

                Looking to book a specific room?

                Browse our

                <a asp-controller="Room"
                   asp-action="Index">
                    Rooms page
                </a>

                and book directly from the room you like.

            </p>

            <p class="form-note" style="margin-top:8px;">

                Already sent us a message?

                <a asp-controller="Contact"
                   asp-action="TrackMessage">
                    Track your message &amp; reply here
                </a>

            </p>

        </div>

        <div class="contact-info">

            <h2>
                Royal Paradise Hotel
            </h2>

            <hr>

            <p>
                📍 <b>Address</b>
                <br>
                A39 Sector 136,
                Noida, Uttar Pradesh
            </p>

            <p>
                📞 <b>Phone</b>
                <br>
                +91 9876543210
            </p>

            <p>
                ✉ <b>Email</b>
                <br>
                royalparadise@gmail.com
            </p>

            <p>
                🕒 <b>Reception</b>
                <br>
                Open 24 &times; 7
            </p>

            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3506.295708918587!2d77.4002004!3d28.5046197!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390ce9000de0cb51%3A0xdd7121232d913fac!2sAtlantis%20Intelligence%20Ltd!5e0!3m2!1sen!2sin!4v1721050000000"
                loading="lazy">
            </iframe>

        </div>

    </div>

</section>

@section Scripts {

    <script src="~/js/contact.js">
    </script>

}