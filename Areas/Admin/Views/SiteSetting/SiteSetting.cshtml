@{
    ViewData["Title"] = "Site Setting";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h2>Site Settings</h2>
            <p>Manage the site name, logo, tagline and contact info shown in the top bar</p>
        </div>
    </div>

    <div class="table-container settings-card">
        <form id="frmData" enctype="multipart/form-data">
            <input type="hidden" id="Id" value="0" />

            <label>Site Name <span class="required-star">*</span></label>
            <input type="text" id="SiteName" />
            <span class="field-error" id="err-SiteName"></span>

            <label>Tagline</label>
            <input type="text" id="Tagline" />

            <label>Phone <span class="required-star">*</span></label>
            <input type="text" id="Phone" />
            <span class="field-error" id="err-Phone"></span>

            <label>Email <span class="required-star">*</span></label>
            <input type="text" id="Email" />
            <span class="field-error" id="err-Email"></span>

            <label>Address</label>
            <input type="text" id="Address" />

            <label>Logo</label>
            <input type="file" id="LogoFile" accept="image/*" />
            <img id="imgPreview" src="" style="display:none;max-width:150px;margin-top:10px;border-radius:8px;" />

            <div class="drawer-footer" style="justify-content:flex-start;">
                <button type="button" id="btnSave">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/Admin/js/Common.js"></script>
<script src="~/Admin/js/Setting.js"></script>
}
