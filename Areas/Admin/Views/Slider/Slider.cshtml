@{
    ViewData["Title"] = "Slider";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/admin/css/Slider.css" rel="stylesheet" />

<div class="page-container">
    <div class="page-header">
        <div>
            <h2>Sliders</h2>
            <p>Manage the image sliders shown on Home, Room, About, Gallery & Contact pages</p>
        </div>

        <div class="header-right">
            <select id="ddlPageFilter">
                <option value="">All Pages</option>
                <option value="Home">Home</option>
                <option value="Room">Room</option>
                <option value="About">About</option>
                <option value="Gallery">Gallery</option>
                <option value="Facility">Facility</option>
            </select>

            <input type="text" id="txtSearch" placeholder="Search Here..." />

            <button id="btnAdd">
                <i class="fa fa-plus"></i> Add New
            </button>
        </div>
    </div>

    <div class="table-container">
        <table id="tblData">
            <thead>
                <tr>
                    <th>Sr.No</th>
                    <th>Image</th>
                    <th>Page</th>
                    <th>Title</th>
                    <th>Display Order</th>
                    <th>Status</th>
                    <th width="150">Action</th>
                </tr>
            </thead>

            <tbody></tbody>
        </table>
    </div>
</div>

<div class="drawer" id="drawer">
    <div class="drawer-header">
        <h3>Slider</h3>
        <span id="closeDrawer">&times;</span>
    </div>

    <div class="drawer-body">
        <form id="frmData" enctype="multipart/form-data" novalidate>

            <input type="hidden" id="Id" value="0" />

            <label>
                Page <span class="required-star">*</span>
            </label>

            <select id="PageKey" style="width:100%;">
                <option value="">-- Select Page --</option>
                <option value="Home">Home</option>
                <option value="Room">Room</option>
                <option value="About">About</option>
                <option value="Gallery">Gallery</option>
                <option value="Facility">Facility</option>
            </select>

            <span class="field-error" id="err-PageKey"></span>

            <label>
                Title <span class="required-star">*</span>
            </label>

            <input type="text" id="Title" />
            <span class="field-error" id="err-Title"></span>

            <label>Sub Title</label>
            <input type="text" id="SubTitle" />

            <label>Button Text</label>
            <input type="text" id="ButtonText" />

            <label>Button Url</label>
            <input type="text" id="ButtonUrl" placeholder="/Room/Index" />

            <label>
                <input type="checkbox"
                       id="IsActive"
                       checked
                       style="width:auto;" />
                Active
            </label>

            <label>
                Slider Image <span class="required-star">*</span>
            </label>

            <input type="file"
                   id="ImageFile"
                   accept="image/*" />

            <span class="field-error" id="err-ImageFile"></span>

            <img id="imgPreview"
                 src=""
                 style="display:none;max-width:100%;margin-top:10px;border-radius:8px;" />

            <div class="drawer-footer">
                <button type="button" id="btnCancel">
                    Cancel
                </button>

                <button type="button" id="btnSave">
                    Save
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="~/Admin/js/Common.js"></script>
    <script src="~/Admin/js/Slider.js"></script>
}