@{
    ViewData["Title"] = "Gallery";
}
<link rel="stylesheet" href="~/Admin/css/Gallery.css" />
<div class="page-container">
    <div class="page-header">
        <div>
            <h2>Gallery</h2>
            <p>Manage photos shown on the public Gallery page</p>
        </div>

        <div class="header-right">
            <input type="text" id="txtSearch" placeholder="Search Here..." />
            <button id="btnAdd">
                <i class="fa fa-plus"></i> Add New
            </button>
        </div>
    </div>

    <div class="table-container">
        <table id="tblData">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Display Order</th>
                    <th>Status</th>
                    <th width="150">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="drawer" id="drawer">
    <div class="drawer-header">
        <h3>Gallery Image</h3>
        <span id="closeDrawer">&times;</span>
    </div>

    <div class="drawer-body">
        <form id="frmData" enctype="multipart/form-data">

            <input type="hidden" id="Id" value="0" />

            <label>
                Title <span class="required-star">*</span>
            </label>

            <input type="text" id="Title" maxlength="100" />
            <span class="field-error" id="err-Title"></span>

            <label>
                Category <span class="required-star">*</span>
            </label>

            <select id="Category">
                <option value="">Select Category</option>
                <option value="Rooms">Rooms</option>
                <option value="Restaurant">Restaurant & Dining</option>
                <option value="Pool">Swimming Pool</option>
                <option value="Lobby">Lobby</option>
                <option value="Reception">Reception</option>
                <option value="Spa">Spa & Wellness</option>
                <option value="Gym">Gym & Fitness</option>
                <option value="Banquet">Banquet Hall</option>
                <option value="Conference">Conference Hall</option>
                <option value="Garden">Garden & Outdoor</option>
                <option value="Events">Events & Celebrations</option>
                <option value="Exterior">Hotel Exterior</option>
            </select>

            <span class="field-error" id="err-Category"></span>

            <label class="active-checkbox">
                <input type="checkbox" id="IsActive" checked />
                Active
            </label>

            <label>
                Image <span class="required-star">*</span>
            </label>

            <input type="file" id="ImageFile" accept="image/*" />
            <span class="field-error" id="err-ImageFile"></span>

            <img id="imgPreview" src="" class="gallery-preview" />

            <div class="drawer-footer">
                <button type="button" id="btnCancel">Cancel</button>
                <button type="button" id="btnSave">Save</button>
            </div>

        </form>
    </div>
</div>

@section Scripts {

    <script src="~/Admin/js/Common.js"></script>
    <script src="~/Admin/js/Gallery.js"></script>
}