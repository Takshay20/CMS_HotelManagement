@{
    ViewData["Title"] = "Room Category";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h2>Room Category</h2>
            <p>Manage room categories (Standard, Deluxe, Suite, etc.)</p>
        </div>
        <div class="header-right">
            <input type="text" id="txtSearch" placeholder="Search Here..." />
            <button id="btnAdd"><i class="fa fa-plus"></i> Add New</button>
        </div>
    </div>

    <div class="table-container">
        <table id="tblData">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Display Order</th>
                    <th>Status</th>
                    <th width="150">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="drawer" id="drawer">
    <div class="drawer-header">
        <h3>Room Category</h3>
        <span id="closeDrawer">&times;</span>
    </div>
    <div class="drawer-body">
        <form id="frmData">
            <input type="hidden" id="Id" value="0" />

            <label>Category Name <span class="required-star">*</span></label>
            <input type="text" id="Name" />
            <span class="field-error" id="err-Name"></span>

            <label>Description</label>
            <textarea id="Description"></textarea>


            <label>
                <input type="checkbox" id="IsActive" checked style="width:auto;" /> Active
            </label>

            <div class="drawer-footer">
                <button type="button" id="btnCancel">Cancel</button>
                <button type="button" id="btnSave">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/Admin/js/Common.js"></script>
<script src="~/Admin/js/RoomCategory.js"></script>
}
