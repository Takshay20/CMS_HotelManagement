@{
    ViewData["Title"] = "Social Media";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h2>Social Media Links</h2>
            <p>Manage social icons shown in the footer</p>
        </div>
        <div class="header-right">
            <input type="text" id="txtSearch" placeholder="Search Here..." />
            <button id="btnAdd"><i class="fa fa-plus"></i> Add New</button>
        </div>
    </div>

    <div class="table-container">
        <table id="tblData">
            <thead>
                <tr>
                    <th>Icon</th>
                    <th>Platform</th>
                    <th>Url</th>
                    <th>Display Order</th>
                    <th>Status</th>
                    <th width="150">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="drawer" id="drawer">
    <div class="drawer-header">
        <h3>Social Media</h3>
        <span id="closeDrawer">&times;</span>
    </div>
    <div class="drawer-body">
        <form id="frmData">
            <input type="hidden" id="Id" value="0" />

            <label>Platform Name <span class="required-star">*</span></label>
            <input type="text" id="PlatformName" placeholder="Facebook" />
            <span class="field-error" id="err-PlatformName"></span>

            <label>Icon (Font Awesome) <span class="required-star">*</span></label>
            <select id="IconClass">
                <option value="">-- Select Icon --</option>
                <option value="fa-brands fa-facebook">Facebook</option>
                <option value="fa-brands fa-instagram">Instagram</option>
                <option value="fa-brands fa-x-twitter">Twitter / X</option>
                <option value="fa-brands fa-linkedin">LinkedIn</option>
                <option value="fa-brands fa-youtube">YouTube</option>
                <option value="fa-brands fa-whatsapp">WhatsApp</option>
                <option value="fa-brands fa-pinterest">Pinterest</option>
                <option value="fa-brands fa-telegram">Telegram</option>
                <option value="fa-brands fa-tiktok">TikTok</option>
                <option value="fa-brands fa-google">Google</option>
                <option value="fa-brands fa-snapchat">Snapchat</option>
                <option value="fa-brands fa-threads">Threads</option>
            </select>
            <span class="field-error" id="err-IconClass"></span>

            <label>Url <span class="required-star">*</span></label>
            <input type="text" id="Url" placeholder="https://facebook.com/yourpage" />
            <span class="field-error" id="err-Url"></span>


            <label>
                <input type="checkbox" id="IsActive" checked style="width:auto;" /> Active
            </label>

            <div class="drawer-footer">
                <button type="button" id="btnCancel">Cancel</button>
                <button type="button" id="btnSave">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/Admin/js/Common.js"></script>
<script src="~/Admin/js/SocialMedia.js"></script>
}
