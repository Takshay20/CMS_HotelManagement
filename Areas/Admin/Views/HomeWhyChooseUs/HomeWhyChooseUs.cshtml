@{
    ViewData["Title"] = "Why Choose Us";
}
<link href="~/admin/css/homewhychooseus.css" rel="stylesheet" />
<div class="page-container">
    <div class="page-header">
        <div>
            <h2>Why Choose Us</h2>
            <p>Manage the "Why Choose Royal Paradise Hotel" boxes shown on the Home page</p>
        </div>
        <div class="header-right">
            <input type="text" id="txtSearch" placeholder="Search Here..." />
            <button type="button"id="btnAllRecords"class="btn-secondary">
                <i class="fa-solid fa-list"></i>
                All Records
            </button>
            <button id="btnAdd"><i class="fa fa-plus"></i> Add New</button>
        </div>
    </div>

    <div class="table-container">
        <table id="tblData">
            <thead>
                <tr>
                    <th>Icon</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Display Order</th>
                    <th>Status</th>
                    <th width="150">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="drawer" id="drawer">
    <div class="drawer-header">
        <h3>Why Choose Us</h3>
        <span id="closeDrawer">&times;</span>
    </div>
    <div class="drawer-body">
        <form id="frmData">
            <input type="hidden" id="Id" value="0" />

            <label>Icon (Font Awesome) <span class="required-star">*</span></label>
            <select id="IconClass"></select>
            <span class="field-error" id="err-IconClass"></span>

            <label>Title <span class="required-star">*</span></label>
            <input type="text" id="Title" />
            <span class="field-error" id="err-Title"></span>

            <label>Description</label>
            <textarea id="Description"></textarea>


            <label>
                <input type="checkbox" id="IsActive" checked /> Active
            </label>

            <div class="drawer-footer">
                <button type="button" id="btnCancel">Cancel</button>
                <button type="button" id="btnSave">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script src="~/Admin/js/Common.js"></script>
<script src="~/Admin/js/HomeWhyChooseUs.js"></script>
}
